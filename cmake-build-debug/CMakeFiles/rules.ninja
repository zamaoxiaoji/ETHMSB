#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = /home/tl/.cache/JetBrains/RemoteDev/dist/7c9711c0212ad_CLion-2024.3.1/bin/cmake/linux/x64/bin/cmake --regenerate-during-build -S/home/tl/HE3DB -B/home/tl/HE3DB/cmake-build-debug
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = /home/tl/.cache/JetBrains/RemoteDev/dist/7c9711c0212ad_CLion-2024.3.1/bin/ninja/linux/x64/ninja $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = /home/tl/.cache/JetBrains/RemoteDev/dist/7c9711c0212ad_CLion-2024.3.1/bin/ninja/linux/x64/ninja -t targets
  description = All primary targets available:

